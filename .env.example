# ============================================================
# 环境变量模板 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 排除）
# 注意：真实密钥切勿提交到 Git 仓库
# ============================================================

# ---- 应用服务（server.js / SCF 运行时）----
# 本地监听端口（SCF 环境由平台注入 _FAAS_RUNTIME_PORT，无需设置）
PORT=9000
# 管理员后台与管理 API 口令（正式部署务必修改）
ADMIN_PASSWORD=admin123

# ---- 火山引擎 TOS 对象存储（问卷数据持久化）----
# 配置后系统自动启用 TOS；留空则回退到本地 data/responses.json
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-shanghai.volces.com
TOS_REGION=cn-shanghai
TOS_BUCKET=psycho-data
TOS_KEY=responses.json

# ---- 腾讯云凭据（仅 scripts/ 下部署、触发器、CORS 运维脚本需要）----
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---- GitHub 凭据（仅 scripts/ 下 GitHub Pages 部署脚本需要）----
# 使用细粒度 Personal Access Token，仅授予目标仓库 Contents 读写权限
GITHUB_TOKEN=
GITHUB_USER=liuze744-Frogtiano
